#!/bin/sh
# memory/ 規則檢查（memory/README.md、L-027）：
# 1. 改到程式、腳本或 memory 條目時，handoff.md 要一起 commit。
# 2. memory 條目 ID 只追加：不能刪掉 HEAD 已有的 ID，也不能重複。
# 確定不需要更新 handoff 時：HANDOFF_OK=1 git commit ...
staged=$(git diff --cached --name-only --diff-filter=ACMRD)
fail=0

if [ "$HANDOFF_OK" != "1" ]; then
  if echo "$staged" | grep -Eq '^(src/|scripts/|test/|memory/(findings|experiments|lessons|rulings|references)\.md)' &&
     ! echo "$staged" | grep -qx 'memory/handoff.md'; then
    echo "pre-commit: 改到 src/scripts/test 或 memory 條目，但 memory/handoff.md 沒有一起更新。" >&2
    echo "  收工要整份覆寫 handoff.md；確定不需要時用 HANDOFF_OK=1 git commit ..." >&2
    fail=1
  fi
fi

for f in findings experiments lessons rulings references; do
  p="memory/$f.md"
  git cat-file -e ":$p" 2>/dev/null || continue
  new=$(git show ":$p" | grep -Eo '^### [A-Z]-[0-9]+' | cut -c5-)
  dup=$(echo "$new" | sort | uniq -d)
  # 整併過的舊 ID 列在檔尾「舊 ID 對照」表（| R-002 | …），算保留
  mapped=$(git show ":$p" | grep -Eo '^\| [A-Z]-[0-9]+ \|' | grep -Eo '[A-Z]-[0-9]+')
  if [ -n "$dup" ]; then
    echo "pre-commit: $p 有重複 ID：$(echo $dup)" >&2; fail=1
  fi
  if git cat-file -e "HEAD:$p" 2>/dev/null; then
    old=$(git show "HEAD:$p" | grep -Eo '^### [A-Z]-[0-9]+' | cut -c5-)
    gone=$(printf '%s\n' "$old" | while read -r id; do [ -n "$id" ] && ! printf '%s\n%s\n' "$new" "$mapped" | grep -qx "$id" && echo "$id"; done)
    if [ -n "$gone" ]; then
      echo "pre-commit: $p 刪掉了既有 ID：$(echo $gone)（只追加，不刪；改狀態欄即可）" >&2; fail=1
    fi
  fi
done

exit $fail
