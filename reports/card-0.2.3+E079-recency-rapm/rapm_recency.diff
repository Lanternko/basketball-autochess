+class Data:
+    """每季的 stint 觀測（用 rapm.observations 讀，過濾規則完全相同），以稀疏設計矩陣表示。"""
+
+    def __init__(self, seasons=ALL_SEASONS, cache=None):
+        cache = Path(cache) if cache else CACHE
+        if cache.exists():
